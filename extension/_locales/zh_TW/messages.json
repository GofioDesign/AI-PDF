  "artExtensions": {
    "message": "擴充功能"
  },
  "step1Title": {
    "message": "將擴充功能固定到工具列"
  },
  "step1Text": {
    "message": "點選 Chrome 右上角的<strong>拼圖</strong>圖示，再點選「AI → PDF」旁的<strong>圖釘</strong>。圖示就會一直顯示。"
  },
  "step2Title": {
    "message": "開啟聊天並點選圖示"
  },
  "step2Text": {
    "message": "在 AI 網站上開啟要儲存的對話，然後點選擴充功能圖示。即使對話很長，也會完整讀取。"
  },
  "step3Title": {
    "message": "儲存 PDF"
  },
  "step3Text": {
    "message": "會開啟一個顯示簡潔檢視的分頁。依需要調整（標題、字級、顯示或隱藏你的訊息），然後點選<strong>列印 / 儲存 PDF</strong>。目的地選擇「另存為 PDF」。"
  },
  "tipsTitle": {
    "message": "小技巧"
  },
  "tipShortcut": {
    "message": "快速鍵：<kbd>Alt</kbd>+<kbd>Shift</kbd>+<kbd>P</kbd>（Mac 上為 <kbd>Option</kbd>+<kbd>Shift</kbd>+<kbd>P</kbd>）。"
  },
  "tipSelection": {
    "message": "如果在點選圖示前選取一段文字，就只會列印這部分。"
  },
