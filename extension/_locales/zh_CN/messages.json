  "artExtensions": {
    "message": "扩展程序"
  },
  "step1Title": {
    "message": "将扩展程序固定到工具栏"
  },
  "step1Text": {
    "message": "点击 Chrome 右上角的<strong>拼图</strong>图标，再点击“AI → PDF”旁边的<strong>图钉</strong>。图标就会一直显示。"
  },
  "step2Title": {
    "message": "打开聊天并点击图标"
  },
  "step2Text": {
    "message": "在 AI 网站上打开要保存的对话，然后点击扩展程序图标。即使对话很长，也会完整读取。"
  },
  "step3Title": {
    "message": "保存 PDF"
  },
  "step3Text": {
    "message": "会打开一个显示简洁视图的标签页。按需调整（标题、字号、显示或隐藏你的消息），然后点击<strong>打印 / 保存 PDF</strong>。目标打印机选择“另存为 PDF”。"
  },
  "tipsTitle": {
    "message": "小提示"
  },
  "tipShortcut": {
    "message": "快捷键：<kbd>Alt</kbd>+<kbd>Shift</kbd>+<kbd>P</kbd>（Mac 上为 <kbd>Option</kbd>+<kbd>Shift</kbd>+<kbd>P</kbd>）。"
  },
  "tipSelection": {
    "message": "如果在点击图标前选中一段文字，则只打印这部分。"
